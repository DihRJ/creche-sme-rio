# Copie para .env.local. Sem VITE_API_URL, o app sobe com o mock local.

# URL publica da API, COM /api no fim. Em producao e a URL do Web Service do Render.
# VITE_API_URL=http://localhost:3001/api

# Forca o mock mesmo com VITE_API_URL definida. Use "false" para bater na API real.
VITE_USAR_MOCK=true
