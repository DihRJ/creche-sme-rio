{
  "name": "fila-unica-server",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "sync": "cp ../contracts/api.ts src/contracts.gen.ts",
    "dev": "npm run sync && tsx watch --env-file-if-exists=.env src/index.ts",
    "start": "tsx --env-file-if-exists=.env src/index.ts",
    "check": "npm run sync && tsc --noEmit",
    "verifica": "node --env-file=.env verifica-conexao.mjs",
    "seed": "tsx --env-file-if-exists=.env src/seed.ts",
    "limpar": "tsx --env-file-if-exists=.env src/limpar.ts",
    "seed-demo": "tsx --env-file-if-exists=.env src/seed-demo.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.0",
    "pg": "^8.13.1",
    "tsx": "^4.19.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "typescript": "^5.7.2"
  }
}
