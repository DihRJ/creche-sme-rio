# ─────────────────────────────────────────────────────────────────────
# NÃO preencha isto à mão. As variáveis do Neon vêm da CLI:
#
#   neon env pull --file fila-unica-app/server/.env --service postgres
#
# O workspace já está vinculado ao projeto "Creche SME RIO"
# (curly-shadow-00730359, org Jarom) e fixado na branch `dev`.
# ─────────────────────────────────────────────────────────────────────

# --- vem do Neon (`neon env pull`) ---

NEON_BRANCH=dev

# POOLED — use no runtime da API (o pool do Express). Host com sufixo `-pooler`.
DATABASE_URL="postgresql://.../neondb?sslmode=require"

# DIRETA — use para DDL: schema.sql no boot, migrações e seed.
# Rodar DDL pela conexão pooled falha de forma intermitente e a mensagem não ajuda.
DATABASE_URL_UNPOOLED="postgresql://.../neondb?sslmode=require"

# --- não vem do Neon, preencha ---

JWT_SEGREDO=gere-com-openssl-rand-hex-32
SEMENTE_PROCESSO=fila-unica-2026
WEB_ORIGIN=http://localhost:5173
PORT=3001
